# EDA repo .gitignore
# Policy: keep circuit sources (circuits/, spice/ curated netlists,
# testbenches/), models/, vendor/ (read-only originals) and scripts/
# under version control. Ignore everything that is regenerated by the
# toolchain (simulation runs, PCB fab outputs, autorouter scratch
# files, python bytecode, the venv itself).

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# --- Virtual environment (recreated by scripts/setup.sh) ---
env/venv/

# --- Downloaded tools (refetched by scripts/setup.sh) ---
scripts/tools/*.jar
scripts/tools/en/

# --- Simulation outputs ---
results/*
!results/.gitkeep
*.raw
*_out.txt
smoke/*_out.txt

# --- Autorouter intermediates (regenerate via route_board.py / freerouting) ---
*.dsn
*.ses
smoke/en/

# --- PCB fabrication outputs (gerbers/drill) ---
fabrication/*
!fabrication/.gitkeep
pcb/fab/
pcb/drc/
gerbers/
*.gbr
*.gbl
*.gtl
*.gbs
*.gts
*.gbp
*.gtp
*.gbo
*.gto
*.gba
*.gta
*.gm1
*.gbrjob
*.drl
*.pos

# --- KiCad transient/lock files ---
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/
fp-info-cache
*.lck
_autosave-*

# --- OS cruft ---
.DS_Store

# --- Detriti SKiDL (rigenerati a ogni esecuzione, vedi limitations #15) ---
*.erc
*.log
*_sklib.py
circuits/**/__pycache__/

# --- Worktree Claude (creati/rimossi dal tool, mai da committare) ---
.claude/worktrees/

# --- Dati del dossier: versionati DI PROPOSITO (AGENTS.md regola 8) ---
# Un gate gira offline su main e deve poter aprire i numeri; `results/` e'
# scratch e gitignorato, quindi non puo' servire a questo. Qui vanno i dati
# CURATI che il dossier impagina, datati, non l'output grezzo di ogni run.
# La negazione e' necessaria perche' le regole globali qui sopra (*.log,
# *_out.txt, *.raw) altrimenti mangerebbero in silenzio proprio i file di
# evidenza.
!docs/preamp/data/**

# L41b2: le forme d'onda delle sequenze (~45 MB l'una, ~1,3 GB in tutto) si
# rifanno con tutti_seq.sh (README della cartella): non sono dati curati.
docs/preamp/data/2026-09-26/L41b2/seq/**/*_out.txt

# L41c: le stesse forme d'onda delle sequenze, e i .dat delle corse audio
# (si rifanno coi comandi del README di L41c)
docs/preamp/data/2026-09-26/L41c/seq/**/*_out.txt
docs/preamp/data/2026-09-26/L41c/corse/*.dat

# L42b: le ricorse per il dossier dell'alimentatore (README di L42b). Le forme
# d'onda di wrdata (~100 MB a caso), quelle delle sequenze, i .dat delle corse
# audio e i deck che dividi.py e raddrizzatore.py rigenerano: ~11 GB, si rifanno
docs/preamp/data/2026-09-27/L42b/rete/*.txt
docs/preamp/data/2026-09-27/L42b/guasti/*.txt
docs/preamp/data/2026-09-27/L42b/carico_l41a/*/*.txt
docs/preamp/data/2026-09-27/L42b/scelte/deck_*.cir
docs/preamp/data/2026-09-27/L42b/l30/corse/*.dat
docs/preamp/data/2026-09-27/L42b/l30/corse/corsa_*.cir
docs/preamp/data/2026-09-27/L42b/l30/corse/deck.cir
docs/preamp/data/2026-09-27/L42b/l30/corse/_analisi_par*/
docs/preamp/data/2026-09-27/L42b-L41b2/seq/**/*_out.txt
docs/preamp/data/2026-09-27/L42b-L41c/seq/**/*_out.txt
docs/preamp/data/2026-09-27/L42b-L41c/corse/*.dat
docs/preamp/data/2026-09-27/L42b-L41c/corse/corsa_*.cir
docs/preamp/data/2026-09-27/L42b-L41c/corse/deck.cir
docs/preamp/data/2026-09-27/L42b-L41c/corse/_analisi_par*/

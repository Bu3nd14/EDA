alter vti dc = 1.0
alter vtr dc = 5.5
alter vtijk dc = 1000
alter vtrjk dc = 2000
tran 1e-05 13.0 0 1e-05
wrdata inv_20_100k$d v(mainjack) v(fixjack1) v(fixjack2)
wrdata inv_20_100k_stati$d v(xls.xs) v(xlp.xs) v(dep) v(ina)
destroy all
echo "inv_20_100k,inv_20_100k.dat,inversione_d75,20,3.818,10,100k,1.0,5.5,13.0,1e-05,evento,sempre_20_100k,mai_20_100k,4.5" >> tb_v2_mute_ldr_manifest.csv

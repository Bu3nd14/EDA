alter vtrjk dc = 2000
tran 1e-05 17.5 0 1e-05
wrdata norele_20_100k$d v(mainjack) v(fixjack1) v(fixjack2)
wrdata norele_20_100k_stati$d v(xls.xs) v(xlp.xs) v(dep) v(ina)
destroy all

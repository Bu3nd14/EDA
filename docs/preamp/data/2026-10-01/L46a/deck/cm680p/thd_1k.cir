alter @vs[sin] = [ 0 0.0897344 1000 ]
tran 4e-07 0.004 0 4e-07
echo "L46A_CASO modo=10 livello=lo freq=1000 ampin=0.0897344"
fourier 1000 v(vsn) v(out)
destroy all
alter rrg = 0.1
alter rrg10 = 0.1
alter @vs[sin] = [ 0 0.897344 1000 ]
tran 4e-07 0.004 0 4e-07
echo "L46A_CASO modo=10 livello=hi freq=1000 ampin=0.897344"

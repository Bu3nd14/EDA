.include /Users/roberto/EDA/.claude/worktrees/L42b/models/mosfet_n/generic_nmos.lib
.include /Users/roberto/EDA/.claude/worktrees/L42b/models/mosfet_p/generic_pmos.lib
.include /Users/roberto/EDA/.claude/worktrees/L42b/models/bjt_npn/generic_npn.lib

.include /Users/roberto/EDA/.claude/worktrees/L41b2/models/mosfet_n/generic_nmos.lib
.include /Users/roberto/EDA/.claude/worktrees/L41b2/models/mosfet_p/generic_pmos.lib
.include /Users/roberto/EDA/.claude/worktrees/L41b2/models/bjt_npn/generic_npn.lib

* L41b2 tb_psu seq spegnimento_l (giro 2) - GENERATED by genera_tb_psu.py from /Users/roberto/EDA/.claude/worktrees/L41c/circuits/preamp/psu.net and /Users/roberto/EDA/.claude/worktrees/L41c/docs/preamp/data/2026-09-26/L41c/seq/spegnimento_l/core_g1.csv

.include /Users/roberto/EDA/.claude/worktrees/L41c/models/diodes/1n4148.lib
.include /Users/roberto/EDA/.claude/worktrees/L41c/models/mosfet_n/generic_nmos.lib
.include /Users/roberto/EDA/.claude/worktrees/L41c/models/mosfet_p/generic_pmos.lib
.include /Users/roberto/EDA/.claude/worktrees/L41c/models/bjt_npn/generic_npn.lib

echo "ev_1k_100k,ev_1k_100k.dat,taglio,1000,3.818,10,100k,1.0,2.0,5.0,1e-05,evento,sempre_1k_100k,mai_1k_100k,0.024,0," >> tb_v2_casopeggiore_manifest.csv
alter vamp dc = 3.818
alter vfrq dc = 1000
alter rldm = 100k
alter rld1 = 100k
alter rld2 = 100k
alter vtijk dc = 1.024000
alter vtrjk dc = 2.024000
alter vosa dc = 0
alter iosa dc = 0
alter vosb dc = 0
alter vosf1 dc = 0
alter vosf2 dc = 0

alter vfrq dc = 1000
alter rldm = 100k
alter rld1 = 100k
alter rld2 = 100k
alter vtijk dc = 1.024000
alter vtrjk dc = 2.024000
alter vosa dc = 0
alter iosa dc = 0
alter vosb dc = 0
alter vosf1 dc = 0
alter vosf2 dc = 0
alter ratth = 1m
alter rattb = 10k
alter rl1 = 1e12
alter cwire = 1e-18

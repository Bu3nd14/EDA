limite jfet VLO rser 10k
* GENERATO da docs/preamp/data/2026-10-02/L47b1/banco/ (L47b1). Banco ridotto: vedi comune.py.
.include /Users/roberto/EDA/.claude/worktrees/L47b1/docs/preamp/data/2026-10-02/L47b1/banco/inc/jfet_angoli.lib
.include /Users/roberto/EDA/.claude/worktrees/L47b1/models/optocoupler/nsl32sr3_comportamentale.lib
.options reltol=1e-6 vntol=1e-6 abstol=1e-12
VSRC VSN 0 DC 0 AC 1 SIN(0 3.818 1k)
RSRC VSN SRCX 1.5
* R_IN del blocco A (gain_block.py, r_in=1M)
RIN AIN 0 1MEG
RSER SRCX AIN 10k
JP AIN GP 0 MMBFJ112_VLO
VC NC 0 DC 0
* il correttivo ideale: meta' esatta di Vds sul gate, piu' il comando
BG GP 0 V = V(AIN)/2 + V(NC)
.control
option itl1=1000
set numdgt=10
set fourgridsize=8192
set nfreqs=10
echo L47B1_CASO d=9.500000
alter vc dc = -1.500000
tran 0.5u 4m 2m 0.5u
fourier 1000 v(vsn) v(ain)
let vdsmax = vecmax(abs(v(ain)))
print vdsmax
destroy all
* il secondo passaggio: la stessa riga di 20 kHz che leggi() si aspetta
alter @vsrc[sin] = [ 0 3.818 20000 ]
tran 25n 0.4m 0.3m 25n
fourier 20000 v(vsn) v(ain)
destroy all
alter @vsrc[sin] = [ 0 3.818 1000 ]
echo L47B1_CASO d=9.550000
alter vc dc = -1.450000
tran 0.5u 4m 2m 0.5u
fourier 1000 v(vsn) v(ain)
let vdsmax = vecmax(abs(v(ain)))
print vdsmax
destroy all

* accensione: primo ordine, tau costante; spegnimento: tasso funzione di log10(R).
BDX 0 xs I = V(xt) >= V(xs) ? min((V(xt) - V(xs))/0.00152576, pow(10, pwl(V(xs), 0.0000,2.4652, 5.0000,2.4652, 5.0200,-0.6229, 9.0000,-0.6229))) : (V(xt) - V(xs))/0.00152576
CXS xs 0 1 IC=7.3979
RXS xs 0 1e12
BCELL c1 c2 I = V(c1,c2) / pow(10, V(xs))
CCELL c1 c2 5p
CIO a c1 0.5p
.model DLED_NSL32SR3 D(IS=2.8e-16 N=2 RS=42.53)
.ends

